APP_NAME="URL Shortener"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=url_shortener
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Cache-aside layer for the redirect lookup (README §22).
# Falls back cleanly to CACHE_STORE=database / array if you don't want to
# run Redis locally — the app works either way, just without the cache.
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1

# Baseline, un-tuned rate limit for POST /api/shorten (README §24).
SHORTEN_RATE_LIMIT_PER_MINUTE=30
